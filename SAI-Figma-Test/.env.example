# SAI Frontend Environment Configuration Example
# Do not store private keys or secrets here.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Google OAuth Public Client ID (Web Client ID from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign-In Services ID (Configured in Apple Developer Portal)
VITE_APPLE_CLIENT_ID=in.sai.platform.web
