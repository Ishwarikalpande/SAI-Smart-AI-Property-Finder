# SAI Smart AI Property Finder - Environment Configuration Example

# Core Application
PROJECT_NAME="SAI - Smart AI Property Finder"
ENVIRONMENT=development
API_V1_STR=/api
DEBUG=True

# Security & JWT
SECRET_KEY=change_this_to_a_super_secret_key_in_production_sai_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite local development: sqlite:///./sai.db
# For PostgreSQL with PostGIS: postgresql+psycopg://postgres:password@localhost:5432/sai_db
DATABASE_URL=sqlite:///./sai.db

# Storage (AWS S3 or Local Fallback)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sai-property-media

# AI Services - Qwen3
LLM_PROVIDER=ollama
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b
QWEN_API_KEY=
VECTOR_DIMENSION=384

# Voice / Speech-to-Text
VOICE_PROVIDER=whisper
WHISPER_MODEL_SIZE=base

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# OAuth Security Policy (Set to true to mandate 6-digit email OTP after Google / Apple sign-in)
REQUIRE_OAUTH_EMAIL_OTP=false

# SMTP / Email Service Configuration for OTP & Password Reset
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=SAI Property Finder

# Super Admin 2FA
ADMIN_2FA_ISSUER="SAI Admin Platform"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:3000"]
